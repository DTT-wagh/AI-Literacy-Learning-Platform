{
  "expo": {
    "name": "智趣AI学堂",
    "slug": "witjoy-academy",
    "version": "0.0.1",
    "orientation": "default",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.witjoyacademy.app"
    },
    "android": {
      "package": "com.witjoyacademy.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "智趣AI学堂需要访问相册，以便选择你的头像。",
          "cameraPermission": "智趣AI学堂需要使用相机，以便拍摄你的头像。",
          "microphonePermission": false
        }
      ]
    ]
  }
}
