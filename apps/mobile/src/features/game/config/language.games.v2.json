      {"id": "bare-judgement", "title": "裸句初判", "description": "先只看一句话，保留你现在的判断。", "mode": "action"},
      {"id": "word-meaning", "title": "词义线索", "description": "看看同一个字在不同句子里怎样变化。", "mode": "action"},
      {"id": "context-evidence", "title": "情境线索", "description": "打开前后文和事件背景，选最关键的证据。", "mode": "action"},
      {"id": "tone-comparison", "title": "表情与语气", "description": "比较不同表情和语气下的同一句话。", "mode": "action"},
      {"id": "ai-comparison", "title": "AI对照", "description": "AI只会根据收到的线索给出候选。", "mode": "ai"},
      {"id": "unknown-case", "title": "未知案件", "description": "信息不够时，负责任地说不确定。", "mode": "action"},
      {"id": "context-review", "title": "案件复盘", "description": "带着证据写下本次判断。", "mode": "result"}
